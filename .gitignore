# dependencies (unanchored on purpose: a nested workspace installs its own, and
# `git add delegate/` must not sweep thousands of them in)
node_modules

# next.js
/.next/
/.next-e2e/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# env files (never commit secrets)
.env
.env*.local

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# playwright
test-results/
playwright-report/
playwright/.cache/

# freebuff session data (local conversation database, never uploaded)
.freebuff/

# benchmarking artifacts (anchored to repo root so lib/finbench,
# public/finbench, and app/finbench stay tracked)
/finbench/
/finbench-output/
.env*
# ...but the env template is tracked on purpose (the README points at it), and
# `.env*` above is unanchored, so it covers the template too. Re-include it, or
# scripts/gitignore-gate.mjs fails on a path that belongs in the repo.
!.env.local.example

# delegate workshop runtime data (participant labels + transcripts — never commit)
delegate/data/
delegate/snapshots/
delegate/dist/
delegate/docs/readout-*.md

# ... and the rehearsal debrief, which is filled from a scripted cohort so the
# facilitator can time the walk, and which says to delete itself once the real
# session has run
delegate/docs/alpha-debrief-REHEARSAL.md

# untracked artifacts that are installed, rendered or checked out rather than
# written here. Anchored, so a nested workspace of the same name stays trackable
# elsewhere; a family with a tracked survivor inside it is globbed (`dir/*`) with
# a negation for that survivor, because a negation inside an ignored directory is
# never reached. Written by `scripts/untracked-gate.mjs --fix`, and read back by
# `scripts/gitignore-gate.mjs`, which fails if a line here covers a tracked path.
# The survivor here is the `libraries-dev` pack and the symlink to it — which is
# why the symlink's negation has no trailing slash, since git reads one as
# "directory only" and would go on skipping a symlink. `/circle-master/` holds
# nothing tracked.
/.agents/skills/*
!/.agents/skills/libraries-dev/
/.claude/skills/*
!/.claude/skills/libraries-dev
/circle-master/
/galaxy-launch-video.mp4
