#!/bin/sh
#
# Commit-time half of the gitignore gate (scripts/gitignore-gate.mjs).
#
# CI runs the same script, but a rule that contradicts a tracked path is cheapest
# to fix at the moment it is written — and it is a contradiction nothing else
# would ever notice: `git status` stays quiet because the path is committed, and
# the rule reads as though the path were never meant to be here.
#
# Install once per clone:  npm run hooks:install
# Skip a single commit:    git commit --no-verify
#
# A check that cannot run must not read as a pass, so a missing `node` or script
# fails the commit loudly rather than letting it through.
set -e

root="$(git rev-parse --show-toplevel)"
exec node "$root/scripts/gitignore-gate.mjs"
