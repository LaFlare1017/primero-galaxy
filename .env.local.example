# Absolute URL of the deployed app. It becomes the metadataBase that
# resolves the canonical link and the Open Graph / Twitter image URLs.
#
# Copy to .env.local for local builds, and set the same value as the
# NEXT_PUBLIC_SITE_URL repository secret in GitHub Actions (see
# .github/workflows/ci.yml). If unset, builds fall back to
# http://localhost:3000.
#
# Replace with the real production domain once deployed.
NEXT_PUBLIC_SITE_URL=https://primero-galaxy.vercel.app
